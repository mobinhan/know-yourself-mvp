# Know Yourself local/dev environment template.
# Public browser connection values; never use service_role or secret API keys here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Optional legacy alternative to SUPABASE_PUBLISHABLE_KEY.
SUPABASE_ANON_KEY=
# Enable only after configuring the corresponding Supabase Auth provider.
KY_AUTH_EMAIL_PASSWORD_ENABLED=true
KY_AUTH_GOOGLE_ENABLED=false
KY_AUTH_APPLE_ENABLED=false
KY_AUTH_FACEBOOK_ENABLED=false

# Existing server-side interpretation provider (optional).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
