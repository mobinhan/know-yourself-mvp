{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/v1", "destination": "/api/index?route=/v1" },
    { "source": "/v1/:path*", "destination": "/api/index?route=/v1/:path*" }
  ],
  "functions": {
    "api/index.py": {
      "excludeFiles": "{engine/test_*.py,engine/test_*.mjs,engine/__pycache__/**,engine/requirements.txt}"
    }
  }
}
