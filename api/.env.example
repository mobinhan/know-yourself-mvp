# Copy these names into the server's encrypted environment settings.
# Never commit a real API key or place one in browser JavaScript.
OPENAI_API_KEY=
# Optional override; the default is gpt-5-mini.
OPENAI_MODEL=gpt-5-mini

# Supabase Auth browser connection (public values; never put service_role/secret keys here).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Legacy alternative if this project has not migrated to publishable keys.
SUPABASE_ANON_KEY=
# Enable only after configuring each provider in Supabase Auth and its developer console.
KY_AUTH_EMAIL_PASSWORD_ENABLED=true
KY_AUTH_GOOGLE_ENABLED=false
KY_AUTH_APPLE_ENABLED=false
KY_AUTH_FACEBOOK_ENABLED=false
